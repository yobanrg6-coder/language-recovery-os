# Language Recovery OS Configuration

# Gemini API Key (Get your free key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection - pinned to an explicit Gemini 3.5+ version, as the
# "All Things Agentic" hackathon rules require ("Gemini 3.5 or newer"). The
# *-latest aliases were flagged by the organizer's eligibility check because
# they can still resolve to a 2.x model on some accounts. gemini-3.5-flash-lite
# supports the multimodal (audio) input the Transcription stage needs;
# gemini-3.6-flash is a drop-in upgrade if you want more capability.
MODEL=gemini-3.5-flash-lite

# Second independent verifier model (Gemma) - used to reconcile the
# Conflict Agent's cross-source contradiction checks, same pattern as the
# sibling hackathon projects (Trusted Hire Mexico, ScopeCouncil).
GEMMA_MODEL=gemma-4-26b-a4b-it

# Web Dashboard
WEB_APP_PORT=8000
# 0.0.0.0 in production - Cloud Run cannot healthcheck a listener bound to
# 127.0.0.1. Safe to leave as 0.0.0.0 for local dev too.
WEB_APP_HOST=0.0.0.0
