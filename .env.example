# Language Recovery OS Configuration

# Gemini API Key (Get your free key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection - use a stable alias, not a pinned version. Pinned model
# names get retired from new accounts without notice; the *-latest aliases
# always resolve to Google's current recommended model. Must support
# multimodal (audio) input for the Transcription stage.
MODEL=gemini-flash-lite-latest

# Web Dashboard
WEB_APP_PORT=8000
# 0.0.0.0 in production - Cloud Run cannot healthcheck a listener bound to
# 127.0.0.1. Safe to leave as 0.0.0.0 for local dev too.
WEB_APP_HOST=0.0.0.0
